tter-spacing: -0.15ex; }

body > header > nav > a { color: inherit; }

a { color: rgb(23, 72, 125); }

h1, h2, h3, h4, h5, h6 { padding: 0px; margin-bottom: 0.5ex; font-family: v=
ar(--em-font); font-weight: bolder; }

h1 { font-size: 300%; letter-spacing: -0.2ex; }

h2 { font-size: 200%; letter-spacing: -0.2ex; color: rgb(38, 102, 195); }

h3 { font-size: 150%; letter-spacing: -0.2ex; color: rgb(38, 102, 195); }

h4 { font-size: 120%; letter-spacing: -0.15ex; color: black; }

h5 { font-size: 100%; letter-spacing: -0.1ex; color: black; }

table.black { border-collapse: collapse; vertical-align: top; padding: 3px;=
 text-align: justify; }

table.black td, table.black th { background: white; }

table.black td > pre { margin: 0px; }

.center { text-align: center; }

table.black th { background: repeating-linear-gradient(-45deg, rgb(68, 143,=
 219), rgb(68, 143, 219) 2ex, rgb(58, 134, 218) 2ex, rgb(58, 134, 218) 4ex)=
; letter-spacing: -0.15ex; color: white; border: 1px solid rgb(19, 57, 100)=
; text-align: center; }

table.black td { border: 1px solid rgb(38, 102, 195); vertical-align: top; =
}

div#main { display: flex; width: 100%; max-width: 100%; min-width: 100%; mi=
n-height: 100vh; box-sizing: border-box; }

article { padding: 0px 1em 1em; flex: 1 1 100%; max-width: 100%; box-sizing=
: border-box; }

@media print, screen and (max-width: 70rem) {
  aside { display: none; }
}

aside { padding: 1em; flex: 1 1 25%; background-color: rgb(236, 243, 251); =
box-sizing: border-box; }

aside > nav { margin: 1em 0px 2em; }

aside > nav > ol { list-style-type: none; margin: 0px 0px 0px 2em; padding:=
 0px; font-family: var(--em-font); font-size: 90%; }

aside > nav > ol > li { text-indent: -2em; }

aside > nav > ol > li.i0 { margin-left: 0em; }

aside > nav > ol > li.i1 { margin-left: 1em; }

aside > nav > ol > li.i2 { margin-left: 2em; }

aside > nav > ol > li.i3 { margin-left: 3em; }

aside > nav > ol > li.i4 { margin-left: 4em; }

form#search { display: flex; width: 100%; }

form#search > input { flex: 1 1 80%; width: 80%; }

form#search > button { flex: 0 0 0%; }

li > p:first-child { margin-top: 0px; margin-bottom: 0px; }

@charset "utf-8";

:root { --em-font: Arial, Helvetica, Sans-serif; }

html, body { margin: 0px; padding: 0px; min-height: 100vh; width: 100%; box=
-sizing: border-box; }

body > header { color: white; background: repeating-linear-gradient(-45deg,=
 rgb(68, 143, 219), rgb(68, 143, 219) 2ex, rgb(58, 134, 218) 2ex, rgb(58, 1=
34, 218) 4ex); }

body > header > h1 { margin: 0px 0.3em; padding: 0px; }

